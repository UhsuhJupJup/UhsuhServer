{
  "uid": "uhsuh-core",
  "title": "어서줍줍 핵심 모니터링",
  "description": "다중 인스턴스(app1, app2) 운영에 필요한 것만 추린 대시보드. 헬스, 응답시간, URL별 지연, 힙, 로그.",
  "tags": [
    "uhsuhjupjup",
    "multi-instance"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"uhsuhjupjup-backend\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1. 핵심 헬스",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "인스턴스 상태",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "각 앱 인스턴스의 스크레이프 성공 여부. DOWN 이면 그 박스가 응답하지 않는 것.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "가동 시간",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "최근 재시작 시각 파악. 한쪽만 짧으면 그 박스가 재시작된 것(OOM 의심).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_uptime_seconds{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "요청 처리량",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "두 인스턴스 합산 초당 요청 수.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "5xx 에러율",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "전체 요청 중 서버 오류 비율.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "2. HTTP 요청 시간",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "평균 응답시간 (인스턴스별)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "sum/count 로 계산한 실제 평균. 두 인스턴스가 벌어지면 한쪽에 문제가 있다는 신호.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_server_requests_seconds_sum{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])) / clamp_min(sum by (instance) (rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "응답시간 SLO 구간별 달성률",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "버킷이 SLO 경계에만 있어(percentiles-histogram=false) 분위수 대신 구간 달성률로 본다. 참 p95 가 필요하면 application.yml 에서 percentiles-histogram 을 켜야 한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"0.05\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 50ms"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"0.1\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 100ms"
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"0.25\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 250ms"
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"0.5\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 500ms"
        },
        {
          "refId": "E",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"1.0\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 1s"
        },
        {
          "refId": "F",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"2.0\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 2s"
        },
        {
          "refId": "G",
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", le=\"5.0\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\"}[5m])), 0.0001) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "≤ 5s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "3. URL 별 평균 응답시간",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "느린 URL Top 10 (추이)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "URI 는 /api/articles/{id} 처럼 템플릿으로 뭉쳐진다. 개별 요청은 로그의 requestId 로 찾는다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_sum{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", uri!~\"/actuator.*\"}[5m])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", uri!~\"/actuator.*\"}[5m])), 0.0001))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{uri}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "URL 별 평균 응답시간, 호출량",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "평균 응답시간과 호출량을 함께 본다. 느려도 호출이 거의 없으면 우선순위가 낮다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", uri!~\"/actuator.*\"}[5m])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", uri!~\"/actuator.*\"}[5m])), 0.0001)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", uri!~\"/actuator.*\"}[5m]))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "uri",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "uri": "URL",
              "Value #A": "평균 응답시간",
              "Value #B": "초당 호출"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "평균 응답시간",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "평균 응답시간"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "초당 호출"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "4. JVM 메모리 - heap 사용량",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 12,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap 사용량 vs 최대",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Xmx 320m 설정. 톱니 모양이 정상(GC 동작). 톱니 바닥이 계속 올라가면 누수 의심.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}} 사용"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (jvm_memory_max_bytes{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
