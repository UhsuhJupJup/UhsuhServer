{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "어서줍줍 Spring Boot 운영 모니터링 — Actuator + Micrometer 메트릭 기반. 위쪽에 가장 중요한 헬스/요청률/에러율, 아래로 갈수록 JVM/스레드/HikariCP/로그 상세 진단.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "🚦 핵심 헬스 — 한눈에 보기",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "앱 상태 (UP/DOWN)",
      "description": "Prometheus 가 backend /actuator/prometheus 를 정상 scrape 하는지. 0 이면 backend 다운 또는 메트릭 endpoint 막힘.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "targets": [
        {
          "expr": "up{job=\"uhsuhjupjup-backend\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "다운",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "앱 가동 시간",
      "description": "Spring Boot 프로세스 시작 이후 경과 시간. 잦은 재시작은 OOM/크래시 의심.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"uhsuhjupjup-backend\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 3600
              }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "CPU 사용률 %",
      "description": "process_cpu_usage — 컨테이너/JVM 내부 CPU 비율. 지속 80%+ 면 스케일아웃/쿼리 최적화 필요.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"uhsuhjupjup-backend\"} * 100",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Heap 사용률 %",
      "description": "jvm_memory_used / max (heap). 90%+ 지속이면 OOM 임박. Old Gen 만 보면 더 정확.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "targets": [
        {
          "expr": "100 * sum(jvm_memory_used_bytes{job=\"uhsuhjupjup-backend\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"uhsuhjupjup-backend\", area=\"heap\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "HTTP RPS",
      "description": "초당 HTTP 요청 수. 평시/피크 대비.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\"}[1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "에러율 (5xx) %",
      "description": "전체 요청 대비 5xx 응답 비율 (5분). 0% 가 정상. 0.5%+ 면 즉시 점검.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 6,
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\"}[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "📈 HTTP 요청 / 응답 시간",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 110,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "상태 코드별 RPS",
      "description": "2xx (정상), 3xx (리다이렉트), 4xx (클라이언트 에러), 5xx (서버 에러) 별 처리량. 4xx 가 튀면 잘못된 요청 / 인증 실패 / 권한. 5xx 면 서버 버그 / DB 단절.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", status=~\"2..\"}[1m]))",
          "refId": "A",
          "legendFormat": "2xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", status=~\"3..\"}[1m]))",
          "refId": "B",
          "legendFormat": "3xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", status=~\"4..\"}[1m]))",
          "refId": "C",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\", status=~\"5..\"}[1m]))",
          "refId": "D",
          "legendFormat": "5xx"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "응답 시간 (평균 / 최대)",
      "description": "전체 HTTP 요청의 평균 응답시간 (rate(sum) / rate(count)). max 가 튀면 특정 요청이 느림.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"uhsuhjupjup-backend\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\"}[1m])), 0.001)",
          "refId": "A",
          "legendFormat": "평균"
        },
        {
          "expr": "max(http_server_requests_seconds_max{job=\"uhsuhjupjup-backend\"})",
          "refId": "B",
          "legendFormat": "최대 (직전 측정)"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "type": "row",
      "title": "🎯 URI 별 활동 Top 10",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 120,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "URI 별 요청률 Top 10 (RPS)",
      "description": "가장 자주 호출되는 엔드포인트. 캐싱/최적화 우선순위 판단 근거.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 9,
      "targets": [
        {
          "expr": "topk(10, sum by(uri) (rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{uri}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "type": "bargauge",
      "title": "URI 별 평균 응답시간 Top 10",
      "description": "가장 느린 엔드포인트. 인덱스/쿼리 최적화 우선순위. /actuator 류는 무시.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 10,
      "targets": [
        {
          "expr": "topk(10, sum by(uri) (rate(http_server_requests_seconds_sum{job=\"uhsuhjupjup-backend\"}[5m])) / clamp_min(sum by(uri) (rate(http_server_requests_seconds_count{job=\"uhsuhjupjup-backend\"}[5m])), 0.001))",
          "refId": "A",
          "legendFormat": "{{uri}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "continuous-BlPu"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "💾 JVM 메모리 (Heap / NonHeap)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 130,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap 사용량 (영역별)",
      "description": "Eden / Survivor / Old Gen (G1 면 Young/Old/Humongous) 별 사용량. Old Gen 이 우상향이면 메모리 누수.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 11,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"uhsuhjupjup-backend\", area=\"heap\"}",
          "refId": "A",
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "NonHeap (Metaspace 등)",
      "description": "Metaspace / Compressed Class Space / Code Cache. Metaspace 우상향이면 클래스 로드 누수 (devtools/redeploy 환경).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 12,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"uhsuhjupjup-backend\", area=\"nonheap\"}",
          "refId": "A",
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "type": "row",
      "title": "♻️ GC (Garbage Collection)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 140,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GC pause 시간 (rate, by gc/action)",
      "description": "1분당 누적 GC 정지 시간. Young GC 는 짧고 잦음, Old/Full GC 는 길고 드물어야. Full GC 가 잦으면 Old Gen 부족.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "id": 13,
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"uhsuhjupjup-backend\"}[1m])",
