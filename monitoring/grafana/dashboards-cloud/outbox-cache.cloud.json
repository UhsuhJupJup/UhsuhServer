{
  "title": "어서줍줍 · 아웃박스 & 캐시",
  "uid": "uhsuh-outbox-cache",
  "tags": [
    "uhsuhjupjup",
    "outbox",
    "dlq",
    "cache"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "label": "Data source"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"uhsuhjupjup-backend\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "sort": 1,
        "label": "instance"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "📮 아웃박스 / DLQ",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "🔴 DLQ 격리 (FAILED)",
      "description": "notification_outbox_failed — 최대 재시도 초과로 격리된(dead-letter) 알림 수. 0이 정상. 1 이상이면 조용한 유실 위험 → 관리자에서 requeue 필요.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 100,
      "targets": [
        {
          "expr": "max(notification_outbox_failed{job=\"uhsuhjupjup-backend\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "🟡 발송 대기 (PENDING)",
      "description": "notification_outbox_pending — 아직 발송 안 된 큐 행. 08:00 버스트 직후 잠깐 오르는 건 정상, 계속 높으면 폴러/발송 정체.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 101,
      "targets": [
        {
          "expr": "max(notification_outbox_pending{job=\"uhsuhjupjup-backend\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "아웃박스 상태 추이 (pending / failed)",
      "description": "발송 큐(PENDING)와 DLQ(FAILED)의 시간 추이. FAILED가 0에서 올라오면 발송 지속 실패 신호. (DB 기반 게이지라 인스턴스 무관 max)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 102,
      "targets": [
        {
          "expr": "max(notification_outbox_pending{job=\"uhsuhjupjup-backend\"})",
          "refId": "A",
          "legendFormat": "대기 (PENDING)"
        },
        {
          "expr": "max(notification_outbox_failed{job=\"uhsuhjupjup-backend\"})",
          "refId": "B",
          "legendFormat": "격리 (FAILED)"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "대기 (PENDING)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "격리 (FAILED)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "♻️ 키워드 그래프 캐시 (L1 Caffeine / L2 Redis)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 2,
      "panels": []
    },
    {
      "type": "stat",
      "title": "keywordGraph L1 적중률 %",
      "description": "L1 적중 / L1 조회(키워드 그래프 캐시에 들어온 모든 조회), 5분. 자세한 것은 '어서줍줍 키워드 그래프 캐시' 대시보드.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "id": 200,
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(uhsuh_cache_local_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result=\"hit\"}[5m])) / clamp_min(sum(rate(uhsuh_cache_local_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"}[5m])), 0.001)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "keywordGraph Redis 까지 간 비율 %",
      "description": "Redis 조회 / L1 조회, 5분. L1 이 적중하면 Redis 를 부르지 않는다. 낮을수록 Redis 접근이 준 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 8
      },
      "id": 201,
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(cache_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"}[5m])) / clamp_min(sum(rate(uhsuh_cache_local_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"}[5m])), 0.001)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "keywordGraph L1 점유 (/ 1000)",
      "description": "L1 에 들어 있는 키 수(인스턴스 최대). 상한 1000 근처면 축출이 생긴다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 8
      },
      "id": 202,
      "targets": [
        {
          "refId": "A",
          "expr": "max(uhsuh_cache_local_size{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"})",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1600
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "keywordGraph 계층별 처리 (L1 적중 / Redis 적중 / DB 집계)",
      "description": "초당 조회를 L1 적중, Redis 적중, 일반 조회의 DB 집계(집계 함수 호출 수)로 나눈다. 자세한 것은 '어서줍줍 키워드 그래프 캐시' 대시보드.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 203,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(uhsuh_cache_local_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result=\"hit\"}[5m]))",
          "legendFormat": "L1 적중"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cache_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result=\"hit\"}[5m]))",
          "legendFormat": "Redis 적중"
        },
        {
          "refId": "C",
          "expr": "sum(rate(uhsuh_cache_loads_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", source=\"read\"}[5m]))",
          "legendFormat": "DB 집계"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "L1 적중"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "L2 적중"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "super-light-yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "origin (미스)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "keywordGraph Redis(L2) 적중률 %",
      "description": "Redis 적중 / Redis 조회(L1 미스 중 대표 요청), 5분. 전역 그래프 캐시는 없어졌다(매번 DB 계산).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 8
      },
      "id": 210,
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(cache_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"}[5m])), 0.001)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "keywordGraph 요청 대비 DB 집계 %",
      "description": "일반 조회의 DB 집계 수 / L1 조회 수, 5분.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 8
      },
      "id": 211,
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(uhsuh_cache_loads_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", source=\"read\"}[5m])) / clamp_min(sum(rate(uhsuh_cache_local_gets_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"}[5m])), 0.001)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "keywordGraph 갱신 (1시간, 저장 / 건너뜀·실패)",
      "description": "매칭 커밋 뒤 갱신 결과의 1시간 증가량. 저장 외의 값은 건너뜀이나 실패다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 8
      },
      "id": 212,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(uhsuh_cache_refreshes_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result=\"stored\"}[1h]))",
          "legendFormat": "저장"
        },
        {
          "refId": "B",
          "expr": "sum(increase(uhsuh_cache_refreshes_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result!=\"stored\"}[1h]))",
          "legendFormat": "건너뜀, 실패"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "keywordGraph Redis 오류와 DB 우회",
      "description": "Redis 명령 오류와, 락 없이 DB 로 넘어간 횟수(원인별)다. 자세한 것은 '어서줍줍 키워드 그래프 캐시' 대시보드.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 213,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (command) (rate(uhsuh_cache_redis_commands_seconds_count{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\", result=\"error\"}[5m]))",
          "legendFormat": "오류 {{command}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(uhsuh_cache_fallbacks_total{job=\"uhsuhjupjup-backend\", instance=~\"$instance\", cache=\"keywordGraph\"}[5m]))",
          "legendFormat": "DB 우회 {{reason}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "L1 적중"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "L2 적중"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "super-light-yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "origin (미스)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}