# 비밀 값만 여기에 둔다. 배포 상수(DB 호스트, 메일 서버, CORS 등)는 docker-compose.yml에 리터럴로 명시돼 있다.
# 서버의 실제 .env는 GitHub Actions가 secrets로 생성한다. 이 파일은 참조/로컬 테스트용.

# MySQL root 비밀번호
MYSQL_ROOT_PASSWORD=

# 앱 DB 계정(uhsuhjupjup) 비밀번호
DB_PASSWORD=

# GHCR 이미지 (배포가 커밋 sha 태그로 덮어씀)
BACKEND_IMAGE=ghcr.io/sinequanonn/uhsuh-backend:latest

# 발신 Gmail 주소 (메일 도입 전까지 비워둠)
MAIL_USERNAME=

# Gmail 앱 비밀번호 16자리 (메일 도입 전까지 비워둠)
MAIL_PASSWORD=

# 메일 활성화 시 할 일:
#   1) 위 MAIL_USERNAME / MAIL_PASSWORD 채우기
#   2) docker-compose.yml 의 MAIL_ENABLED 를 "true" 로 변경
#   -> false 인 동안은 LoggingEmailSender 가 발송 대신 로그만 남긴다
